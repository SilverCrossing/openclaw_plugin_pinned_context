{
  "name": "openclaw-plugin-pinned-context",
  "version": "0.1.0",
  "description": "用户可控的 strong 与 context 钉选块，支持私聊和群聊作用域",
  "keywords": ["openclaw", "plugin", "context", "memory", "pinned-context"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilverCrossing/openclaw_plugin_pinned_context.git"
  },
  "homepage": "https://github.com/SilverCrossing/openclaw_plugin_pinned_context#readme",
  "bugs": {
    "url": "https://github.com/SilverCrossing/openclaw_plugin_pinned_context/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.2"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.10.2",
      "minGatewayVersion": "2026.10.2"
    },
    "build": {
      "openclawVersion": "2026.10.2",
      "pluginSdkVersion": "2026.10.2"
    }
  }
}
